{
  "name": "dsh-compaction-opencode",
  "version": "0.2.2",
  "description": "OpenCode's context-compaction policy ported to DeepSeek Harness: a structured checkpoint summary with a single-nudge retry, a verbatim recent tail aligned to a user-message boundary, a 0.7/0.5/0.35 shrink ladder, and a flatten-and-drop-oldest fallback.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./dsh.plugin.json": "./dsh.plugin.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.7-rc.2": "compatible",
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "compaction",
    "context",
    "opencode"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-compaction": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-token-meter": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-util-values": ">=0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
